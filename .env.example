# Set only the provider you explicitly choose. This file is never auto-loaded.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
DEEPRESEARCH_DATA_DIR=data/private
# Disable temporary Python operations for live runs unless needed.
MIX_DISABLE_SANDBOX_PYTHON=1

# Optional non-model service credentials. Set only variables supported by the selected entrypoint.
# This template does not add new provider integrations.
AMAP_API_KEY=
AMAP_SECURITY_JS_CODE=
LANGSMITH_API_KEY=
LANGCHAIN_API_KEY=
OPENALEX_API_KEY=
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
